# Cloud Functions environment — copy to functions/.env for LOCAL use.
# functions/.env is gitignored and never committed.
#
# For a real DEPLOY, prefer Firebase secrets over a plain .env for the secret key:
#   firebase functions:secrets:set PAYSTACK_SECRET_KEY
#
# The Paystack SECRET key. Starts with sk_test_ (test) or sk_live_ (live).
# NEVER commit this and never put it in client code.
PAYSTACK_SECRET_KEY=

# Optional: when premium expires (end of this day, West Africa Time).
# If unset or already past, premium falls back to 120 days from purchase.
SEMESTER_END=2026-09-30
