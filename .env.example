# ---------------------------------------------------------------------------
# ReadingStreak environment variables
#
# Copy this file to `.env` and fill in the real values from your Firebase
# project (Project settings -> General -> "Your apps" -> Web app config).
#
#   cp .env.example .env
#
# NEVER commit `.env`. It is gitignored. Only this example file is tracked.
# Vite only exposes variables prefixed with VITE_ to the client. That is why
# every var below starts with VITE_.
#
# IMPORTANT: The Firebase *web* config below is not a secret — it ships in the
# browser by design, and your data is protected by Firestore security rules
# (Phase 3), not by hiding these values. The Paystack SECRET key is a real
# secret and will live ONLY in Cloud Functions config, never here.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# Set to "true" to connect the app to the local Firebase Emulator Suite
# instead of the real cloud project. Great for development — no billing,
# no real emails, safe to break things.
VITE_USE_EMULATORS=true
